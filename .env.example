# Demo mode needs no key. Never commit .env or a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional absolute directory; defaults to .local_data beside app.py.
# MRI_DATA_DIR=
# Enable only on a trusted single-user local computer (unencrypted storage).
MRI_ENABLE_LOCAL_HISTORY=false
